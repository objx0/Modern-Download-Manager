<Window
    x:Class="ModernDownloadManager.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ModernDownloadManager.App.ViewModels">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="12,0" Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="144"/></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Width="40" Height="32" Padding="0" Content="&#xE700;" FontFamily="Segoe MDL2 Assets" Click="AppTitleBar_PaneToggleRequested" ToolTipService.ToolTip="Toggle navigation"/>
            <Border Grid.Column="1" Width="30" Height="30" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}" Margin="10,0,0,0">
                <FontIcon Glyph="&#xE896;" Foreground="White" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Modern Download Manager" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind ViewModel.HeaderText, Mode=OneWay}" FontSize="11" Opacity="0.65"/>
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" IsSettingsVisible="True" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="All downloads" Tag="All"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7C5;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Active" Tag="Active"><NavigationViewItem.Icon><FontIcon Glyph="&#xE768;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Completed" Tag="Completed"><NavigationViewItem.Icon><FontIcon Glyph="&#xE73E;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItemSeparator/><NavigationViewItemHeader Content="Categories"/>
                <NavigationViewItem Content="Compressed" Tag="Category:Compressed"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7B8;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Documents" Tag="Category:Documents"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Music" Tag="Category:Music"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8D6;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Video" Tag="Category:Video"><NavigationViewItem.Icon><FontIcon Glyph="&#xE714;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Programs" Tag="Category:Programs"><NavigationViewItem.Icon><FontIcon Glyph="&#xE756;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Images" Tag="Category:Images"><NavigationViewItem.Icon><FontIcon Glyph="&#xEB9F;"/></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Padding="32,26,32,24">
                <Grid Visibility="{Binding IsSettingsView, Converter={StaticResource InverseBoolToVisibility}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{x:Bind ViewModel.HeaderText, Mode=OneWay}" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Fast, resumable downloads with everything important in view." Style="{StaticResource PageIntroStyle}"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,22" ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" PlaceholderText="Paste a download URL" Text="{x:Bind ViewModel.NewUrlText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="Add download" Style="{StaticResource AccentButtonStyle}" Click="AddDownload_Click"/>
                    </Grid>

                    <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.VisibleDownloads}" SelectionMode="None" BorderThickness="0" Padding="0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:DownloadItemViewModel">
                                <Border Style="{StaticResource DownloadCardStyle}">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" CornerRadius="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <FontIcon Glyph="&#xE7C5;" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{x:Bind FileName, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind CategoryText, Mode=OneWay}" Style="{StaticResource MetaTextStyle}"/>
                                            <ProgressBar Value="{x:Bind ProgressPercent, Mode=OneWay}" Maximum="100" Margin="0,4,0,0"/>
                                            <StackPanel Orientation="Horizontal" Spacing="14">
                                                <TextBlock Text="{x:Bind SizeText, Mode=OneWay}" Style="{StaticResource MetaTextStyle}"/>
                                                <TextBlock Text="{x:Bind SpeedText, Mode=OneWay}" Style="{StaticResource MetaTextStyle}"/>
                                                <TextBlock Text="{x:Bind EtaText, Mode=OneWay}" Style="{StaticResource MetaTextStyle}"/>
                                                <TextBlock Text="{x:Bind StateText, Mode=OneWay}" Style="{StaticResource MetaTextStyle}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                                            <Button Style="{StaticResource DownloadIconButtonStyle}" IsEnabled="{x:Bind CanPause, Mode=OneWay}" Command="{x:Bind PauseCommand}" ToolTipService.ToolTip="Pause"><FontIcon Glyph="&#xE769;"/></Button>
                                            <Button Style="{StaticResource DownloadIconButtonStyle}" IsEnabled="{x:Bind CanResume, Mode=OneWay}" Command="{x:Bind ResumeCommand}" ToolTipService.ToolTip="Resume"><FontIcon Glyph="&#xE768;"/></Button>
                                            <Button Style="{StaticResource DownloadIconButtonStyle}" IsEnabled="{x:Bind CanOpenFile, Mode=OneWay}" Command="{x:Bind OpenFileCommand}" ToolTipService.ToolTip="Open file"><FontIcon Glyph="&#xE8A5;"/></Button>
                                            <Button Style="{StaticResource DownloadIconButtonStyle}" IsEnabled="{x:Bind CanOpenFolder, Mode=OneWay}" Command="{x:Bind OpenFolderCommand}" ToolTipService.ToolTip="Open folder"><FontIcon Glyph="&#xE8B7;"/></Button>
                                            <Button Style="{StaticResource DownloadIconButtonStyle}" Command="{x:Bind RemoveCommand}" ToolTipService.ToolTip="Remove"><FontIcon Glyph="&#xE74D;"/></Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource MetaTextStyle}" Margin="0,8,0,0"/>
                </Grid>

                <ScrollViewer Visibility="{Binding IsSettingsView, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel MaxWidth="700" HorizontalAlignment="Left" Spacing="4">
                        <TextBlock Text="Settings" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Control how downloads are captured, stored, and completed." Style="{StaticResource PageIntroStyle}"/>

                        <TextBlock Text="Browser capture" Style="{StaticResource SettingsGroupStyle}"/>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <ToggleSwitch Header="Send browser downloads to Modern Download Manager" IsOn="{x:Bind ViewModel.Settings.BrowserCaptureEnabled, Mode=TwoWay}"/>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Minimum capture size" FontWeight="SemiBold"/><TextBlock Text="Files smaller than this stay in the browser. Use 0 to capture every size." Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap"/></StackPanel>
                                    <NumberBox Grid.Column="1" Value="{x:Bind ViewModel.Settings.MinimumCaptureSizeMB, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Inline" PlaceholderText="0"/>
                                </Grid>
                                <TextBlock Text="Size is measured in MB and is applied to known browser download sizes. Unknown sizes are checked again by the app." Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Downloads" Style="{StaticResource SettingsGroupStyle}"/>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Default download folder" Style="{StaticResource FieldLabelStyle}"/>
                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Grid.Column="0" Text="{x:Bind ViewModel.Settings.DefaultDownloadFolder, Mode=TwoWay}"/><Button Grid.Column="1" Content="Browse" Click="BrowseFolder_Click"/></Grid>
                                <TextBlock Text="Max simultaneous downloads" Style="{StaticResource FieldLabelStyle}"/>
                                <NumberBox Value="{x:Bind ViewModel.Settings.MaxConcurrentDownloads, Mode=TwoWay}" Minimum="1" Maximum="16" SpinButtonPlacementMode="Inline" HorizontalAlignment="Left" Width="160"/>
                                <TextBlock Text="Default speed limit (MB/s, 0 = unlimited)" Style="{StaticResource FieldLabelStyle}"/>
                                <NumberBox Value="{x:Bind ViewModel.Settings.DefaultSpeedLimitMBps, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Inline" HorizontalAlignment="Left" Width="160"/>
                                <TextBlock Text="Connections per download" Style="{StaticResource FieldLabelStyle}"/>
                                <NumberBox Value="{x:Bind ViewModel.Settings.DefaultSegmentCount, Mode=TwoWay}" Minimum="1" Maximum="16" SpinButtonPlacementMode="Inline" HorizontalAlignment="Left" Width="160"/>
                                <ToggleSwitch Header="Show a notification when a download completes" IsOn="{x:Bind ViewModel.Settings.ShowCompletionNotifications, Mode=TwoWay}" Margin="0,14,0,0"/>
                                <ToggleSwitch Header="Show a tray icon while the manager is running" IsOn="{x:Bind ViewModel.Settings.ShowTrayIcon, Mode=TwoWay}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Button Content="Save settings" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.Settings.SaveCommand}" Margin="0,14,0,0" HorizontalAlignment="Left"/>
                        <TextBlock Text="{x:Bind ViewModel.Settings.SaveStatusText, Mode=OneWay}" Style="{StaticResource MetaTextStyle}" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
