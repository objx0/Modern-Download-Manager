<Window x:Class="ModernDownloadManager.App.DownloadDialogWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="DialogRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="16">
  <Grid.Resources>
   <Style TargetType="Button"><Setter Property="MinHeight" Value="34"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="14,5"/></Style>
   <Style TargetType="TextBox"><Setter Property="MinHeight" Value="32"/><Setter Property="CornerRadius" Value="2"/><Setter Property="Padding" Value="8,4"/></Style>
   <Style TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer x:Name="SetupScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid x:Name="SetupPanel" VerticalAlignment="Top" RowSpacing="12" ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="Address:"/><TextBox AutomationProperties.Name="Download address" x:Name="UrlBox" Grid.Column="1" IsReadOnly="True"/>
   <TextBlock Grid.Row="1" Text="Category:"/><ComboBox AutomationProperties.Name="File category" x:Name="CategoryBox" Grid.Row="1" Grid.Column="1" Width="250" MinHeight="32"/>
   <TextBlock Grid.Row="2" Text="Save as:"/>
   <Grid Grid.Row="2" Grid.Column="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBox AutomationProperties.Name="Save as" x:Name="SaveAsBox"/><Button Grid.Column="1" Content="&#x2026;" Padding="0" Click="BrowseSave_Click" AutomationProperties.Name="Choose download file"/></Grid>
   <CheckBox x:Name="RememberBox" Grid.Row="3" Grid.Column="1" Content="Remember path for this category" IsChecked="True"/>
   <StackPanel Grid.Row="4" Grid.Column="1" Spacing="6">
    <CheckBox x:Name="BackgroundBox" Content="Download in background" IsChecked="True"/>
    <TextBlock Text="The capture window closes after the download is accepted." Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap"/>
   </StackPanel>
   <TextBlock x:Name="SetupError" Grid.Row="5" Grid.Column="1" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
   <StackPanel Grid.Row="1" Grid.RowSpan="3" Grid.Column="2" VerticalAlignment="Center" Spacing="12"><FontIcon x:Name="FileTypeIcon" Glyph="&#xE8A5;" FontSize="38" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock x:Name="CaptureSize" TextWrapping="Wrap" TextAlignment="Center" FontSize="12"/></StackPanel>
  </Grid>
  </ScrollViewer>
  <ScrollViewer x:Name="ProgressScroller" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid x:Name="ProgressPanel" Visibility="Collapsed" RowSpacing="12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border HorizontalAlignment="Left" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" Padding="12,6"><TextBlock x:Name="ProgressTitle" Text="Download status" FontWeight="SemiBold"/></Border>
   <Border Grid.Row="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
    <Grid RowSpacing="10" ColumnSpacing="16">
     <Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock x:Name="ProgressAddress" Grid.ColumnSpan="2" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
     <TextBlock Grid.Row="1" Text="Status"/><TextBlock x:Name="ProgressState" Grid.Row="1" Grid.Column="1" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
     <TextBlock Grid.Row="2" Text="File size"/><TextBlock x:Name="ProgressTotal" Grid.Row="2" Grid.Column="1"/>
     <TextBlock Grid.Row="3" Text="Downloaded"/><TextBlock x:Name="ProgressSize" Grid.Row="3" Grid.Column="1"/>
     <TextBlock Grid.Row="4" Text="Transfer rate"/><TextBlock x:Name="ProgressSpeed" Grid.Row="4" Grid.Column="1"/>
     <TextBlock Grid.Row="5" Text="Time left"/><TextBlock x:Name="ProgressEta" Grid.Row="5" Grid.Column="1"/>
     <TextBlock Grid.Row="6" Text="Resume capability"/><TextBlock x:Name="ResumeCapability" Grid.Row="6" Grid.Column="1"/>
     <TextBlock x:Name="ProgressError" Grid.Row="7" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
    </Grid>
   </Border>
   <ProgressBar x:Name="ProgressBar" Grid.Row="2" Minimum="0" Maximum="100" Height="16" CornerRadius="0"/>
   <StackPanel Grid.Row="3" Spacing="10">
    <Button x:Name="DetailsButton" Content="Show details" Click="Details_Click" HorizontalAlignment="Left"/>
    <Border x:Name="DetailsPanel" Visibility="Collapsed" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" Padding="14">
     <StackPanel Spacing="10"><TextBlock Text="Download details" FontWeight="SemiBold"/><TextBlock x:Name="ProgressFileName" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ProgressLocation" TextWrapping="Wrap"/><TextBlock x:Name="ConnectionInfo"/></StackPanel>
    </Border>
   </StackPanel>
  </Grid>
  </ScrollViewer>
  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,16,0,0">
   <Button x:Name="SecondaryButton" Content="Download Later" Width="150" Click="SecondaryButton_Click"/>
   <Button x:Name="PrimaryButton" BorderBrush="{ThemeResource AccentTextFillColorPrimaryBrush}" Content="Start Download" Width="150" Click="PrimaryButton_Click"/>
   <Button x:Name="CloseButton" Content="Cancel" Width="150" Click="CloseButton_Click"/>
  </StackPanel>
 </Grid>
</Window>
