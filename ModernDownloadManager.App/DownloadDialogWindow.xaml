<Window
    x:Class="ModernDownloadManager.App.DownloadDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#2B2B2B" Padding="32,26,22,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="76" />
        </Grid.RowDefinitions>

        <Grid x:Name="SetupPanel" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Download File" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,20" />
            <TextBlock Grid.Row="1" Text="URL" Opacity="0.72" Margin="0,0,0,8" />
            <TextBox x:Name="UrlBox" Grid.Row="2" IsReadOnly="True" Height="44" />
            <TextBlock Grid.Row="3" Text="Category" Opacity="0.72" Margin="0,20,0,8" />
            <ComboBox x:Name="CategoryBox" Grid.Row="4" Height="40" HorizontalAlignment="Stretch" />
            <Grid Grid.Row="5" Margin="0,20,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="44"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Save As" Opacity="0.72" Margin="0,0,0,8" />
                <TextBox x:Name="SaveAsBox" Grid.Row="1" Height="44" />
                <CheckBox x:Name="RememberBox" Grid.Row="2" Content="Remember path for this category" IsChecked="True" Margin="0,14,0,0" />
            </Grid>
        </Grid>

        <Grid x:Name="ProgressPanel" Grid.Row="0" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="ProgressTitle" Text="Downloading" FontSize="26" FontWeight="SemiBold" />
                <TextBlock x:Name="ProgressState" Grid.Column="1" Text="Queued" Opacity="0.72" VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="ProgressFileName" Grid.Row="1" TextTrimming="CharacterEllipsis" Opacity="0.78" Margin="0,10,0,18" />
            <ProgressBar x:Name="ProgressBar" Grid.Row="2" Minimum="0" Maximum="100" Height="8" />
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="18" Margin="0,14,0,0">
                <TextBlock x:Name="ProgressSize" Opacity="0.72" />
                <TextBlock x:Name="ProgressSpeed" Opacity="0.72" />
                <TextBlock x:Name="ProgressEta" Opacity="0.72" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="-32,0,-22,0" Background="#242424" Padding="32,16,22,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="PrimaryButton" Grid.Column="0" Content="Download Now" Height="40" Click="PrimaryButton_Click" />
            <Button x:Name="SecondaryButton" Grid.Column="1" Content="Download Later" Height="40" Margin="10,0,0,0" Click="SecondaryButton_Click" />
            <Button x:Name="CloseButton" Grid.Column="2" Content="Cancel" Height="40" Margin="10,0,0,0" Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>
