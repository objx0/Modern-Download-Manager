<Window x:Class="ModernDownloadManager.App.InformationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
 <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid>
                <ScrollViewer Padding="24" x:Name="AboutPanel" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="680" HorizontalAlignment="Left" Spacing="10">
                        <TextBlock Text="About Modern Download Manager" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="A modern, resumable download manager with a shared cross-platform core." Style="{StaticResource PageIntroStyle}"/>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Modern Download Manager" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding VersionText, Mode=OneWay}" Style="{StaticResource MetaTextStyle}"/>
                                <TextBlock Text="Built with .NET for reliable, multi-connection downloads. The project shares one download engine across native desktop experiences, with Windows and Linux support in development." TextWrapping="Wrap" Style="{StaticResource MetaTextStyle}"/>
                                <Button Content="Open GitHub repository" Style="{StaticResource AccentButtonStyle}" Click="OpenRepository_Click" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Padding="24" x:Name="OptionsPanel">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="4">
                        <TextBlock Text="Options" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Organized controls for capture, downloads, and app behavior." Style="{StaticResource PageIntroStyle}" Margin="0,0,0,10"/>
                        <TabView Style="{StaticResource SettingsTabsStyle}">
                            <TabViewItem Style="{StaticResource SettingsTabItemStyle}">
                                <TabViewItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE774;" FontSize="15" />
                                        <TextBlock Text="Browser capture" VerticalAlignment="Center" />
                                    </StackPanel>
                                </TabViewItem.Header>
                                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,14,12,0">
                                <StackPanel Spacing="12">
                                    <ToggleSwitch Header="Send browser downloads to Modern Download Manager" IsOn="{Binding Settings.BrowserCaptureEnabled, Mode=TwoWay}"/>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="Minimum capture size" FontWeight="SemiBold"/><TextBlock Text="Files smaller than this stay in the browser. Use 0 to capture every size." Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap"/></StackPanel>
                                        <NumberBox Grid.Column="1" Value="{Binding Settings.MinimumCaptureSizeMB, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Inline" PlaceholderText="0"/>
                                    </Grid>
                                    <TextBlock Text="Size is measured in MB and applies to known browser download sizes." Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap"/>
                                </StackPanel>
                                </Border>
                            </TabViewItem>
                            <TabViewItem Style="{StaticResource SettingsTabItemStyle}">
                                <TabViewItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE896;" FontSize="15" />
                                        <TextBlock Text="Downloads" VerticalAlignment="Center" />
                                    </StackPanel>
                                </TabViewItem.Header>
                                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,14,12,0">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Default download folder" Style="{StaticResource FieldLabelStyle}"/>
                                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Grid.Column="0" Text="{Binding Settings.DefaultDownloadFolder, Mode=TwoWay}"/><Button Grid.Column="1" Content="Browse" Click="BrowseFolder_Click"/></Grid>
                                    <TextBlock Text="Max simultaneous downloads" Style="{StaticResource FieldLabelStyle}"/>
                                    <NumberBox Value="{Binding Settings.MaxConcurrentDownloads, Mode=TwoWay}" Minimum="1" Maximum="16" SpinButtonPlacementMode="Inline" HorizontalAlignment="Left" Width="160"/>
                                    <TextBlock Text="Default speed limit (MB/s, 0 = unlimited)" Style="{StaticResource FieldLabelStyle}"/>
                                    <NumberBox Value="{Binding Settings.DefaultSpeedLimitMBps, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Inline" HorizontalAlignment="Left" Width="160"/>
                                    <TextBlock Text="Connections per download" Style="{StaticResource FieldLabelStyle}"/>
                                    <NumberBox Value="{Binding Settings.DefaultSegmentCount, Mode=TwoWay}" Minimum="1" Maximum="16" SpinButtonPlacementMode="Inline" HorizontalAlignment="Left" Width="160"/>
                                </StackPanel>
                                </Border>
                            </TabViewItem>
                            <TabViewItem Style="{StaticResource SettingsTabItemStyle}">
                                <TabViewItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE713;" FontSize="15" />
                                        <TextBlock Text="Behavior" VerticalAlignment="Center" />
                                    </StackPanel>
                                </TabViewItem.Header>
                                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,14,12,0">
                                <StackPanel Spacing="12">
                                    <ToggleSwitch Header="Keep the PC awake while downloads are active" IsOn="{Binding Settings.PreventSleepDuringDownloads, Mode=TwoWay}"/>
                                    <TextBlock Text="Prevents Windows from entering sleep while the queue is downloading. The request is released when downloads finish." Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap"/>
                                    <ToggleSwitch Header="Start Modern Download Manager with Windows" IsOn="{Binding Settings.StartWithWindows, Mode=TwoWay}"/>
                                    <TextBlock Text="Adds the app to your per-user Windows startup applications. No administrator permission is required." Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap"/>
                                    <ToggleSwitch Header="Show a notification when a download completes" IsOn="{Binding Settings.ShowCompletionNotifications, Mode=TwoWay}" Margin="0,8,0,0"/>
                                    <ToggleSwitch Header="Show a tray icon while the manager is running" IsOn="{Binding Settings.ShowTrayIcon, Mode=TwoWay}"/>
                                </StackPanel>
                                </Border>
                            </TabViewItem>
                        </TabView>
                        <Button Content="Save settings" Style="{StaticResource AccentButtonStyle}" Command="{Binding Settings.SaveCommand}" Margin="0,18,0,0" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding Settings.SaveStatusText, Mode=OneWay}" Style="{StaticResource MetaTextStyle}" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
 </Grid>
 <Border Grid.Row="1" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
 <Button Content="Close" Click="Close_Click" HorizontalAlignment="Right" MinWidth="100"/>
 </Border>
 </Grid>
</Window>
