<Window
    x:Class="ModernDownloadManager.App.DownloadMiniWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ModernDownloadManager.App.ViewModels">
    <Grid x:Name="WindowRoot" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="MiniTitleBar" Grid.Row="0" Padding="12,0" Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="30" Height="30" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}"><FontIcon Glyph="&#xE896;" Foreground="White" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <TextBlock Grid.Column="1" Text="Modern Download Manager" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
        </Grid>
        <Border Grid.Row="1" Margin="12,0,12,12" Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid x:Name="Root">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="{x:Bind ViewModel.FileName, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <ProgressBar Grid.Row="1" Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" Maximum="100" Margin="0,14,0,10" Height="6"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="14"><TextBlock Text="{x:Bind ViewModel.SizeText, Mode=OneWay}" Style="{StaticResource MetaTextStyle}"/><TextBlock Text="{x:Bind ViewModel.SpeedText, Mode=OneWay}" Style="{StaticResource MetaTextStyle}"/><TextBlock Text="{x:Bind ViewModel.EtaText, Mode=OneWay}" Style="{StaticResource MetaTextStyle}"/><TextBlock Text="{x:Bind ViewModel.StateText, Mode=OneWay}" Style="{StaticResource MetaTextStyle}"/></StackPanel>
                <StackPanel Grid.Row="3" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8" Margin="0,14,0,0"><Button Content="Pause" Command="{x:Bind ViewModel.PauseCommand}" IsEnabled="{x:Bind ViewModel.CanPause, Mode=OneWay}" Style="{StaticResource QuietActionButtonStyle}"/><Button Content="Resume" Command="{x:Bind ViewModel.ResumeCommand}" IsEnabled="{x:Bind ViewModel.CanResume, Mode=OneWay}" Style="{StaticResource QuietActionButtonStyle}"/><Button Content="Open folder" Command="{x:Bind ViewModel.OpenFolderCommand}" IsEnabled="{x:Bind ViewModel.CanOpenFolder, Mode=OneWay}" Style="{StaticResource QuietActionButtonStyle}"/><Button Content="Open file" Command="{x:Bind ViewModel.OpenFileCommand}" IsEnabled="{x:Bind ViewModel.CanOpenFile, Mode=OneWay}" Style="{StaticResource QuietActionButtonStyle}"/></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
