<Window
    x:Class="ModernDownloadManager.App.DownloadMiniWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ModernDownloadManager.App.ViewModels">
    <Grid x:Name="WindowRoot" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="MiniTitleBar" Grid.Row="0" Padding="{StaticResource MiniPagePadding}" Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="30" Height="30" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}"><FontIcon Glyph="&#xE896;" Foreground="White" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <TextBlock Grid.Column="1" Text="Modern Download Manager" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
        </Grid>
        <Border Grid.Row="1" Margin="0,0,0,0" Padding="{StaticResource CardPadding}" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid x:Name="Root">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding FileName, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding StateText, Mode=OneWay}" Style="{StaticResource MetaTextStyle}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
                <ProgressBar Grid.Row="1" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Margin="0,14,0,10" Height="6"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="14"><TextBlock Text="{Binding SizeText, Mode=OneWay}" Style="{StaticResource MetaTextStyle}"/><TextBlock Text="{Binding SpeedText, Mode=OneWay}" Style="{StaticResource MetaTextStyle}"/><TextBlock Text="{Binding EtaText, Mode=OneWay}" Style="{StaticResource MetaTextStyle}"/><TextBlock Text="{Binding StateText, Mode=OneWay}" Style="{StaticResource MetaTextStyle}"/></StackPanel>
                <TextBlock Grid.Row="3" Text="{Binding DownloadedDateText, Mode=OneWay}" Style="{StaticResource MetaTextStyle}" Margin="0,14,0,0"/>
                <StackPanel Grid.Row="4" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0"><Button Content="Pause" Command="{Binding PauseCommand}" IsEnabled="{Binding CanPause, Mode=OneWay}" Style="{StaticResource QuietActionButtonStyle}"/><Button Content="Resume" Command="{Binding ResumeCommand}" IsEnabled="{Binding CanResume, Mode=OneWay}" Style="{StaticResource QuietActionButtonStyle}"/><Button Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding CanCancel, Mode=OneWay}" Style="{StaticResource QuietActionButtonStyle}"/><Button Content="Open folder" Command="{Binding OpenFolderCommand}" IsEnabled="{Binding CanOpenFolder, Mode=OneWay}" Style="{StaticResource QuietActionButtonStyle}"/><Button Content="Open file" Command="{Binding OpenFileCommand}" IsEnabled="{Binding CanOpenFile, Mode=OneWay}" Style="{StaticResource QuietActionButtonStyle}"/></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
