<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared Fluent tokens. Keep surfaces tied to the Windows theme so light,
         dark, and high-contrast modes remain legible without separate palettes. -->
    <x:Double x:Key="AppCornerRadius">8</x:Double>
    <Thickness x:Key="MainPagePadding">32,26,32,24</Thickness>
    <Thickness x:Key="DialogPagePadding">32,26,32,0</Thickness>
    <Thickness x:Key="MiniPagePadding">16,0,16,16</Thickness>
    <Thickness x:Key="CardPadding">18,16,18,16</Thickness>

    <Style TargetType="Button">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <Style TargetType="NumberBox">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>

    <!-- Card style for each row in the download list -->
    <Style x:Key="DownloadCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="SettingsCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="SettingsGroupStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,18,0,6" />
    </Style>

    <Style x:Key="SettingsTabsStyle" TargetType="TabView">
        <Setter Property="TabWidthMode" Value="SizeToContent" />
        <Setter Property="IsAddTabButtonVisible" Value="False" />
        <Setter Property="CanReorderTabs" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="SettingsTabItemStyle" TargetType="TabViewItem">
        <Setter Property="IsClosable" Value="False" />
        <Setter Property="MinWidth" Value="132" />
        <Setter Property="Padding" Value="14,8" />
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="PageIntroStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,-10,0,18" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,14,0,6" />
    </Style>

    <Style x:Key="MetaTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="QuietActionButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinWidth" Value="88" />
    </Style>

    <Style x:Key="DownloadIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="AccentButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="18,7" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="NewDownloadButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

</ResourceDictionary>
