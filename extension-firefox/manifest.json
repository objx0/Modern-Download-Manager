{
  "manifest_version": 3,
  "name": "Modern Download Manager",
  "version": "1.0.0",
  "description": "Send downloads to Modern Download Manager for faster, resumable, multi-connection downloading.",
  "browser_specific_settings": {
    "gecko": {
      "id": "modern-download-manager@local",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_title": "Modern Download Manager",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": [
    "contextMenus",
    "downloads",
    "nativeMessaging",
    "storage",
    "cookies"
  ],
  "host_permissions": ["<all_urls>"]
}
