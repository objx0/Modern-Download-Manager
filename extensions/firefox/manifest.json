{
  "manifest_version": 3,
  "name": "Modern Download Manager",
  "version": "1.0.4",
  "description": "Send downloads to Modern Download Manager for faster, resumable, multi-connection downloading.",
  "browser_specific_settings": {
    "gecko": {
      "id": "modern-download-manager@local",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_title": "Modern Download Manager",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "contextMenus",
    "downloads",
    "nativeMessaging",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
